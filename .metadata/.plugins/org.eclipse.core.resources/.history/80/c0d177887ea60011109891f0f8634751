#include "open_interface.h"

#include "movement.h"


void move_forward(oi_t *sensor, int centimeters){
    int wheel_speed = 250;

    double sum = 0;
    oi_setWheels(wheel_speed, wheel_speed);

    int adj_centimeters = centimeters*10 - 40;
    while (sum < adj_centimeters){
        oi_update(sensor);
        sum += sensor->distance;
    }

    oi_setWheels(0,0);
}


